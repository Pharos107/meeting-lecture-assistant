     "text": "không được nhiều ở đây vấn đề chủ trì đây có một số điểm lưu ý này"
    },
    {
     "t": 872.7,
     "n": 18,
     "text": "là khác thì chúng ta có hai kết quả chúng ta đạt được những việc có ý kiến"
    },
    {
     "t": 956.4,
     "n": 19,
     "text": "không thì đấy là cái vẫn là có một điểm chia sẻ như vậy thôi ừ thì mình tất"
    },
    {
     "t": 962.4,
     "n": 34,
     "text": "có những bạn là cái điều đó nhưng mà ta cố gắng ở cái trạng thái là chúng ta làm thế nào để làm cho con người sẵn sàng nói ra ý kiến của"
    },
    {
     "t": 1118.4,
     "n": 36,
     "text": "gì giải quyết được vấn đề đúng bản chất vấn đề và quyết định ra đúng thời gian sau khi ra quyết định được vấn đề thì tạo ra mọi người tâm lý còn thực ra"
    },
    {
     "t": 1130.5,
     "n": 25,
     "text": "tốt mà mọi người không tổng vận thì làm việc cầm trừng làm việc đối phó làm việc không tâm lý thì nó cũng tốt"
    },
    {
     "t": 1159.3,
     "n": 14,
     "text": "đây là thực hiện này hay là hành động này là thực hiện quyết"
    },
    {
     "t": 1242.3,
     "n": 12,
     "text": "sõ điểm chỉ có một cái sự dựa chọn như là tốt"
    },
    {
     "t": 1252.8,
     "n": 130,
     "text": "là chúng ta đã chú ý là như vậy để chúng ta hẳn góp thế còn trong cuộc họp thì điều hành kiểm soát đây để dân mặt cáp để kiểm soát nghĩa nhé ở dự họp thảo luận ý"
    },
    {
     "t": 1289.2,
     "n": 29,
     "text": "một số kỹ năng để nó chuyển từ cái phát huyệt sang thành đồng tọa ví dụ như là đàm phán và thương lượng như đi đâu xây dựng"
    },
    {
     "t": 1296.0,
     "n": 23,
     "text": "cái gì đó thì nó sẽ là thế đó và quan trọng của cuộc họp thì kỳ vọng của những người tham gia"
    },
    {
     "t": 1304.5,
     "n": 57,
     "text": "đối tượng nếu mà kỳ vọng họ tham gia giống với người trụ tạo giống với tinh thần dung cuộc họp thì vấn đề sẽ khác còn kỳ vọng nó không phù hợp thì nó sẽ khác sau này chúng"
    },
    {
     "t": 1320.6,
     "n": 54,
     "text": "nhiều khi chúng ta học xong rồi nhân viên cứ tập trung vào cạnh nhau và người nọ là lên kia hoặc là chế trách người kia thì lại không phải là vấn đề thì đấy là chúng ta chú"
    },
    {
     "t": 1338.7,
     "n": 22,
     "text": "chúng ta cố gắng làm thế nào làm cho một chiếc cổ cổ mang lại đúng ra như ta cần tức là"
    },
    {
     "t": 1343.1,
     "n": 102,
     "text": "đúng và hiệu lụng đúng không ạ cần có thời gian xa đổi thì mọi người chẳng sàng cùng chia sẻ và tất nhiên họ chỉ chia sẻ để họ hiểu biết và tâm nhiên còn thiếu hiểu biết và"
    },
    {
     "t": 1366.3,
     "n": 31,
     "text": "chất nhiệm thì không bao giờ họ đồng tình cho một cái mà không hiểu cho nên là giải trình là một cái này chính là kỹ năng thức trình kỹ"
    },
    {
     "t": 1374.2,
     "n": 33,
     "text": "diễn trả ý kiến của mình để phân tích cho người họ có nhiều khi người ta thấy là có nhiều khi nói mái mà họ vẫn không hiểu mà họ không hiểu"
    },
    {
     "t": 1380.6,
     "n": 69,
     "text": "không đi tiếp luận được thế nên là một vấn đề thứ thích đưa ra quan điểm bảo vệ những ý tưởng mới có một cái kỹ năng để vi động tư duyên tập thể ví dụ như vậy và"
    },
    {
     "t": 1399.2,
     "n": 19,
     "text": "là thể hiện vai trò của mình còn trong quá trình thảo luận chia sẻ ý kiến thì đây"
    },
    {
     "t": 1402.7,
     "n": 12,
     "text": "vấn đề xảy ra cảm ơn như chúng ta đã nói nếu"
    },
    {
     "t": 1407.5,
     "n": 91,
     "text": "thì nó sẽ xảy ra những tình trạng như thế này không một phụ họ có thể là gì nếu họ mất thời gian không được thiết vì người ta không nhận những cái người ta cẩn người ta không"
    },
    {
     "t": 1457.4,
     "n": 47,
     "text": "tốt thì như chúng ta đã chỉ bày ở trên thế thì đấy là tất cả những vấn đề mà có thể trao đổi thêm với chúng ta trong cái buổi ngày hôm nay và tôi chỉ chúc bạn thấy"
    }
